# Default provider. Override with VERSO_PROVIDER to compare models on the same corpus.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional
# CEREBRAS_API_KEY=csk-...          # for VERSO_PROVIDER=cerebras
# ANTHROPIC_API_KEY=sk-ant-...      # for VERSO_PROVIDER=anthropic
# VERSO_PROVIDER=deepseek           # deepseek | cerebras | anthropic
# VERSO_MODEL=deepseek-v4-flash     # provider-specific model id
# VERSO_TEMPERATURE=0               # 0 keeps coverage_pct reproducible
# VERSO_REASONING_EFFORT=low        # deepseek only
# VERSO_WORKERS=6                   # parallel parses in a batch run
# VERSO_OCR=1                       # enable the scanned-PDF path (needs tesseract)
